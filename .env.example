# Copy to .env and fill in. Never commit the real .env file.
SECRET_KEY=generate-a-long-random-string          # python -c "import secrets; print(secrets.token_hex(32))"
TMDB_API_KEY=
OMDB_API_KEY=
DATABASE_URL=sqlite:///local_test.db              # or mysql://USER:PASSWORD@HOST:4000/DBNAME for TiDB / MySQL
APP_NAME=MovieRater
# Optional database TLS settings (remote MySQL-family databases are verified by default):
# DB_SSL_CA=/path/to/ca.pem          custom CA file (default: certifi's public CA bundle)
# DB_SSL_VERIFY=0                    encrypted but NOT verified (only if verification fails)
# DB_SSL=0                           no TLS (local database only)
# Optional: lets an uptime pinger keep the database awake via /healthz?db=1&token=...
# HEALTHCHECK_TOKEN=
